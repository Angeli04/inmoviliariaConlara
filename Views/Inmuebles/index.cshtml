@model IEnumerable<Inmobiliaria.Models.Inmuebles>
@{
    ViewData["Title"] = "Inmuebles";
}

<h1>
    Inmuebles
    <div class="btn-group pull-right">
        <a class="btn btn-primary" asp-action="Create" title="Crear">Crear Inmueble<i class="fa-solid fa-plus"></i></a>
    </div>
    </h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().IdInmuebles)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Direccion)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Ambientes)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Superficie)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Latitud)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Longitud)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Duenio)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().TipoInmueble)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Precio)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Habilitado)</th>
            <th></th> </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.IdInmuebles)</td>
                <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                <td>@Html.DisplayFor(modelItem => item.Ambientes)</td>
                <td>@Html.DisplayFor(modelItem => item.Superficie)</td>
                <td>@Html.DisplayFor(modelItem => item.Latitud)</td>
                <td>@Html.DisplayFor(modelItem => item.Longitud)</td>
                <td>
                    @(item.Duenio != null ? $"{item.Duenio.Nombre} {item.Duenio.Apellido}" : "Sin propietario")
                </td>
                <td>@Html.DisplayFor(modelItem => item.TipoInmueble)</td>
                <td>@Html.DisplayFor(modelItem => item.Precio)</td>
                <td>@Html.DisplayFor(modelItem => item.Habilitado)</td>
                <td>
                    <div class="btn-group" role="group">
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.IdInmuebles" title="Editar">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.IdInmuebles" title="Eliminar">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>